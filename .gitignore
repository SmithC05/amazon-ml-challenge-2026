# Amazon ML Challenge 2026 — .gitignore

# ── Datasets (never commit raw data) ─────────────────────────────────────────
dataset/
*.tsv
*.csv
# Exception: keep stub output files that are tracked deliberately
!output/.gitkeep

# ── M4 Large Generated Artifacts ─────────────────────────────────────────────
output/candidate_pairs.tsv
output/matching_results.tsv
m4_production/*.tsv
m4_production/*.duckdb
m4_benchmark/**/*.duckdb
m4_duckdb_tmp/
# ── M2 Preprocessing cache (rebuilt locally) ─────────────────────────────────
cache/
*.parquet

# ── Model artifacts (rebuilt locally or downloaded from Drive) ───────────────
models/*.pkl
models/*.bin
models/*.pt
models/*.onnx
# Keep model_config.json tracked (small, important metadata)
!models/model_config.json

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# ── Notebooks checkpoints ────────────────────────────────────────────────────
.ipynb_checkpoints/

# ── Virtual environments ──────────────────────────────────────────────────────
venv/
.venv/
env/
.env

# ── OS / editor ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.lnk
.idea/
.vscode/
*.swp
*~

# ── Secrets ───────────────────────────────────────────────────────────────────
*.env
.env.*
secrets.json

# DuckDB files
*.duckdb
*.duckdb.wal

